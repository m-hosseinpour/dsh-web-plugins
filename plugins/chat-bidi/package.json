{
  "name": "dsh-chat-bidi",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Per-block bidirectional layout for chat messages, the agent question card, the session sidebar, and the document preview.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-hosseinpour/dsh-web-plugins.git",
    "directory": "plugins/chat-bidi"
  },
  "engines": {
    "dsh": "^0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
